FROM python:3.12-slim

# Use /app as the working directory inside the container.
WORKDIR /app

# Install the system compiler required by some Python packages.
# Remove the package-manager cache afterward to keep the image smaller.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install the same Python dependencies used by GHOST.
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the complete GHOST project into the image.
COPY . /app

# Allow Python to import the ragstream package from /app.
ENV PYTHONPATH=/app

# Prevent Python from creating .pyc files and disable output buffering.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Listen on every container network interface.
# Port 8000 will later be reached internally through Nginx.
ENV GHOST_MCP_HOST=0.0.0.0
ENV GHOST_MCP_PORT=8000
EXPOSE 8000

# Start the authenticated GHOST MCP server.
CMD ["python", "-m", "ragstream.mcp.server"]